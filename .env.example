# ---- Application ----
NODE_ENV=development

# ---- Database ----
# SQLite local file (relative to project root). For Docker, mount a volume to /app/data.
DATABASE_URL="file:./prisma/dev.db"

# ---- Auth.js (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="please-change-me-in-production-this-is-a-dev-secret-only"

# Trust proxy headers for IP detection (set to 1 behind nginx/cloudflare/etc)
AUTH_TRUST_HOST=1

# ---- Initial super admin (only used by `npm run db:seed`) ----
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@123"
